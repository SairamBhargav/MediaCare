# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# bundle verification output (npm run bundle:ios)
dist-check/

# local env files (never commit secrets; EXPO_PUBLIC_* values are visible in the app bundle)
.env
.env.*
!.env.example

# private media, device exports and diagnostics: never commit real photos
private-media/
device-exports/
*.heic
*.HEIC
*.mov
*.MOV

# signing material
*.cer
*.certSigningRequest
credentials.json
