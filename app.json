{
  "expo": {
    "name": "MediaCare",
    "slug": "mediacare",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mediacare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bhargav.mediacare",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F6F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0B0B0F"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "MediaCare reads your photos’ dates, sizes and types on this iPhone to find bursts, screenshots and long videos. Nothing is uploaded.",
          "savePhotosPermission": "MediaCare saves the smaller copies you choose to make as new photos.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
